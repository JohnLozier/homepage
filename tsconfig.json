{
	"extends": "astro/tsconfigs/base",
	"compilerOptions": {
		"target": "ESNext",
		"module": "esnext",
		"explainFiles": true,
		"jsx": "preserve",
		"moduleResolution": "bundler",
		"jsxImportSource": "solid-js",
		"strict": true,
		"allowSyntheticDefaultImports": true,
		"verbatimModuleSyntax": null,
		"isolatedModules": true,
		"paths": {
			"~/*": ["./src/*"],
			"markdown-it-katex": ["./src/types/markdown-it-katex.d.ts"]
		},
		"typeRoots": [
			"./node_modules/@types",
			"./src/types"
		],
		"baseUrl": "."
	}
}